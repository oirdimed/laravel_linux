        die "Hardening échoué."
    }
    
    echo "$HARDENING_RESULT" | grep -E "^(FAIL2BAN_|FIREWALL_|SYSCTL_|UPGRADES_|HARDENING_)" | while read -r line; do
        case "$line" in
            *_OK) success "$line" ;;
            *_FAILED|*_NOT_SUPPORTED) warning "$line" ;;
            HARDENING_COMPLETE) success "Hardening terminé" ;;
            *) info "$line" ;;
        esac
    done
fi

# ============================================================
# TEST FINAL
# ============================================================
echo
info "Test final : ssh $SSH_ALIAS"

if ssh -o ConnectTimeout=15 "$SSH_ALIAS" "echo CONNECTION_OK; whoami; sudo whoami" 2>/dev/null; then
    echo
    echo "============================================================"
    echo -e "${GREEN}        SECURISATION TERMINEE AVEC SUCCÈS${NC}"
    echo "============================================================"
    echo
    echo "Serveur       : $SERVER"
    echo "OS            : $OS_PRETTY"
    [[ "$IS_PROXMOX" == "yes" ]] && echo "Proxmox       : $PVE_VERSION"
    echo "Init          : $INIT_SYSTEM"
    echo "OpenSSH       : $SSH_VERSION_NUM"
    echo "Type clé      : $KEY_TYPE"
    echo "Utilisateur   : $ADMIN_USER"
    echo "Alias SSH     : $SSH_ALIAS"
    echo "Clé privée    : $KEY_FILE"
    echo
    echo "Connexion : ssh $SSH_ALIAS"
    echo
    echo "Sécurité appliquée :"
    [[ "$APPLY_SSH_BASE" == "yes" ]] && echo "  ✓ SSH de base sécurisé"
    [[ "$DO_TCP_FORWARD" == "yes" ]] && echo "  ✓ TCP forwarding ACTIVÉ"
    [[ "$DO_TCP_FORWARD" == "no" ]] && echo "  ✓ TCP forwarding DÉSACTIVÉ"
    [[ "$DO_FAIL2BAN" == "yes" ]] && echo "  ✓ Fail2ban actif"
    [[ "$DO_FIREWALL" == "yes" ]] && echo "  ✓ Firewall iptables actif"
    [[ "$DO_SYSCTL" == "yes" ]] && echo "  ✓ Sysctl hardening actif"
    [[ "$DO_UNATTENDED" == "yes" ]] && echo "  ✓ Mises à jour auto actives"
    [[ -n "${KEYS_TO_DELETE_B64:-}" ]] && echo "  ✓ Clés suspectes supprimées"
    echo
    echo "Commandes utiles :"
    [[ "$DO_FAIL2BAN" == "yes" ]] && echo "  fail2ban-client status sshd"
    [[ "$DO_FIREWALL" == "yes" ]] && echo "  iptables -L -n -v"
    echo "============================================================"
else
    echo
    warning "Test final échoué."
    warning "NE FERME PAS ta session SSH actuelle."
    warning "Teste manuellement : ssh $SSH_ALIAS"
    exit 1
fi
