#!/usr/bin/env bash

# ============================================================
# secure-server-universal.sh
#
# Script de sécurisation SSH ADAPTATIF + HARDENING
# Compatible Debian 6/7/11/12 et Proxmox 8/9
#
# PRINCIPE : chaque action critique est soumise à confirmation
# ============================================================

set -Eeuo pipefail

# ------------------------------------------------------------
# Couleurs
# ------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'

info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warning() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }
die()     { error "$*"; exit 1; }

# Fonction de confirmation universelle
confirm() {
    local prompt="$1"
    local default="${2:-n}"
    local answer
    
    if [[ "$default" == "y" ]]; then
        read -rp "$prompt [Y/n] " answer
        [[ ! "$answer" =~ ^[Nn]$ ]] && return 0 || return 1
    else
        read -rp "$prompt [y/N] " answer
        [[ "$answer" =~ ^[Yy]$ ]] && return 0 || return 1
    fi
}

# ------------------------------------------------------------
# Vérifications locales
# ------------------------------------------------------------
[[ $EUID -eq 0 ]] && die "Ne lance pas ce script en root sur ta machine locale."

for cmd in ssh ssh-keygen ping sshpass; do
    command -v "$cmd" >/dev/null 2>&1 || die "$cmd n'est pas installé."
done

# ------------------------------------------------------------
# Introduction
# ------------------------------------------------------------
clear
echo "============================================================"
echo "   SECURISATION SSH ADAPTATIVE + HARDENING"
echo "   (Legacy Debian 6/7 & Moderne Debian 11/12 / Proxmox)"
echo "============================================================"
echo
echo "Ce script va te demander confirmation à chaque étape."
echo "Tu peux annuler à tout moment avec Ctrl+C."
echo
warning "Conserve TOUJOURS une session SSH ouverte pendant la procédure."
echo

if ! confirm "Démarrer le script ?" "y"; then
    die "Annulé par l'utilisateur."
fi

# ============================================================
# ÉTAPE 1 : CONNEXION AU SERVEUR
# ============================================================
echo
echo "============================================================"
echo "   ÉTAPE 1/8 : CONNEXION AU SERVEUR"
echo "============================================================"

read -rp "Adresse IP ou hostname : " SERVER
[[ -n "$SERVER" ]] || die "Adresse vide."
[[ "$SERVER" =~ ^[a-zA-Z0-9._:-]+$ ]] || die "Adresse invalide."

echo
info "Test de disponibilité : $SERVER"
if ping -c 2 -W 2 "$SERVER" >/dev/null 2>&1; then
    success "Ping OK."
else
    warning "Ping échoué (ICMP bloqué ?)."
    if ! confirm "Tester quand même le port SSH 22 ?" "y"; then
        die "Serveur considéré comme inaccessible."
    fi
fi

info "Test du port SSH 22..."
if timeout 5 bash -c "</dev/tcp/$SERVER/22" 2>/dev/null; then
    success "Port 22 accessible."
else
    die "Port 22 inaccessible."
fi

echo
read -rsp "Mot de passe root : " ROOT_PASSWORD
echo
[[ -n "$ROOT_PASSWORD" ]] || die "Mot de passe vide."

export SSHPASS="$ROOT_PASSWORD"

SSH_ROOT_OPTS=(
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o ConnectTimeout=15
    -o PreferredAuthentications=password
    -o PubkeyAuthentication=no
    -o LogLevel=ERROR
)

info "Connexion root..."
if ! sshpass -e ssh "${SSH_ROOT_OPTS[@]}" "root@$SERVER" "echo ROOT_LOGIN_OK" 2>/dev/null | grep -q "ROOT_LOGIN_OK"; then
    unset SSHPASS
    die "Connexion root impossible."
fi
success "Connexion root réussie."

# ============================================================
# ÉTAPE 2 : DÉTECTION DE L'ENVIRONNEMENT
# ============================================================
echo
echo "============================================================"
echo "   ÉTAPE 2/8 : DÉTECTION DE L'ENVIRONNEMENT"
echo "============================================================"

DETECTION_SCRIPT=$(cat <<'DETECT_EOF'
#!/bin/bash
echo "===DETECTION_START==="

if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS_ID="${ID:-unknown}"; OS_VERSION="${VERSION_ID:-unknown}"; OS_PRETTY="${PRETTY_NAME:-unknown}"
elif [ -f /etc/debian_version ]; then
    OS_ID="debian"; OS_VERSION="$(cat /etc/debian_version)"; OS_PRETTY="Debian $OS_VERSION"
else
    OS_ID="unknown"; OS_VERSION="unknown"; OS_PRETTY="Unknown"
fi

IS_PROXMOX="no"
if [ -f /etc/pve/.version ] || command -v pveversion >/dev/null 2>&1; then
    IS_PROXMOX="yes"
    PVE_VERSION="$(pveversion 2>/dev/null | head -1 || echo unknown)"
else
    PVE_VERSION="none"
fi

INIT_SYSTEM="unknown"
if [ -d /run/systemd/system ] || (command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1); then
    INIT_SYSTEM="systemd"
elif [ -f /etc/init.d/ssh ] || [ -f /etc/init.d/sshd ]; then
    INIT_SYSTEM="sysvinit"
fi

SSH_VERSION="$(sshd -V 2>&1 || ssh -V 2>&1)"
SSH_VERSION_NUM="$(echo "$SSH_VERSION" | grep -oE '[0-9]+\.[0-9]+(p[0-9]+)?' | head -1)"
SSH_MAJOR="$(echo "$SSH_VERSION_NUM" | cut -d'.' -f1)"
SSH_MINOR="$(echo "$SSH_VERSION_NUM" | cut -d'.' -f2 | sed 's/p.*//')"

SUPPORTS_ED25519="no"
if [ "$SSH_MAJOR" -gt 6 ] 2>/dev/null || { [ "$SSH_MAJOR" -eq 6 ] && [ "$SSH_MINOR" -ge 5 ]; } 2>/dev/null; then
    SUPPORTS_ED25519="yes"
fi

MAJOR_DEB="$(echo "$OS_VERSION" | cut -d'.' -f1)"
SUPPORTS_DROPIN="no"
if [ -d /etc/ssh/sshd_config.d ] && [ "$MAJOR_DEB" -ge 12 ] 2>/dev/null; then
    SUPPORTS_DROPIN="yes"
fi

HAS_SUDO="no"
command -v sudo >/dev/null 2>&1 && HAS_SUDO="yes"

SUDOERS_INCLUDE="no"
[ -f /etc/sudoers ] && grep -qE '^[[:space:]]*#includedir[[:space:]]+/etc/sudoers\.d' /etc/sudoers 2>/dev/null && SUDOERS_INCLUDE="yes"

SSHD_CONFIG="/etc/ssh/sshd_config"

SUPPORTS_SSHD_T="no"
sshd -t >/dev/null 2>&1 && SUPPORTS_SSHD_T="yes"

# Détection utilisateurs existants
EXISTING_USERS=$(awk -F: '$3 >= 1000 && $3 < 65000 {print $1}' /etc/passwd | tr '\n' ',' | sed 's/,$//')

echo "OS_ID=$OS_ID"
echo "OS_VERSION=$OS_VERSION"
echo "OS_PRETTY=$OS_PRETTY"
echo "IS_PROXMOX=$IS_PROXMOX"
echo "PVE_VERSION=$PVE_VERSION"
echo "INIT_SYSTEM=$INIT_SYSTEM"
echo "SSH_VERSION_NUM=$SSH_VERSION_NUM"
echo "SUPPORTS_ED25519=$SUPPORTS_ED25519"
echo "SUPPORTS_DROPIN=$SUPPORTS_DROPIN"
echo "HAS_SUDO=$HAS_SUDO"
echo "SUDOERS_INCLUDE=$SUDOERS_INCLUDE"
echo "SSHD_CONFIG=$SSHD_CONFIG"
echo "SUPPORTS_SSHD_T=$SUPPORTS_SSHD_T"
echo "EXISTING_USERS=$EXISTING_USERS"
echo "===DETECTION_END==="
DETECT_EOF
)

DETECT_B64=$(printf '%s' "$DETECTION_SCRIPT" | base64 -w0)
DETECTION_OUTPUT=$(sshpass -e ssh "${SSH_ROOT_OPTS[@]}" "root@$SERVER" \
    "echo '$DETECT_B64' | base64 -d | bash" 2>/dev/null) || die "Échec de la détection."

parse_detection() {
    local key="$1"
    echo "$DETECTION_OUTPUT" | grep "^${key}=" | cut -d'=' -f2-
}

OS_ID=$(parse_detection "OS_ID")
OS_VERSION=$(parse_detection "OS_VERSION")
OS_PRETTY=$(parse_detection "OS_PRETTY")
IS_PROXMOX=$(parse_detection "IS_PROXMOX")
PVE_VERSION=$(parse_detection "PVE_VERSION")
INIT_SYSTEM=$(parse_detection "INIT_SYSTEM")
SSH_VERSION_NUM=$(parse_detection "SSH_VERSION_NUM")
SUPPORTS_ED25519=$(parse_detection "SUPPORTS_ED25519")
SUPPORTS_DROPIN=$(parse_detection "SUPPORTS_DROPIN")
HAS_SUDO=$(parse_detection "HAS_SUDO")
SUDOERS_INCLUDE=$(parse_detection "SUDOERS_INCLUDE")
SSHD_CONFIG=$(parse_detection "SSHD_CONFIG")
SUPPORTS_SSHD_T=$(parse_detection "SUPPORTS_SSHD_T")
EXISTING_USERS=$(parse_detection "EXISTING_USERS")

echo
echo "  OS              : $OS_PRETTY"
[[ "$IS_PROXMOX" == "yes" ]] && echo "  Proxmox VE      : $PVE_VERSION"
echo "  Init system     : $INIT_SYSTEM"
echo "  OpenSSH         : $SSH_VERSION_NUM"
echo "  Ed25519 support : $SUPPORTS_ED25519"
echo "  Drop-in config  : $SUPPORTS_DROPIN"
echo "  sudo installé   : $HAS_SUDO"
echo "  Utilisateurs    : ${EXISTING_USERS:-aucun}"

# ============================================================
# ÉTAPE 3 : SCAN DES CLÉS SSH EXISTANTES
# ============================================================
echo
echo "============================================================"
echo "   ÉTAPE 3/8 : SCAN DES CLÉS SSH (DÉTECTION HACK)"
echo "============================================================"

if ! confirm "Scanner les clés SSH existantes sur le serveur ?" "y"; then
    warning "Scan ignoré. Aucune vérification de backdoor ne sera faite."
    KEY_INDEX=0
else
    KEY_SCAN_SCRIPT=$(cat <<'KEYSCAN_EOF'
#!/bin/bash
echo "===KEYSCAN_START==="

calc_fp() {
    local key_line="$1"
    local b64=$(echo "$key_line" | awk '{print $2}')
    echo -n "$b64" | sha256sum 2>/dev/null | cut -c1-16 || echo -n "$b64" | md5sum 2>/dev/null | cut -c1-16
}

scan_auth_keys() {
    local file="$1"
    local owner="$2"
    
    if [ -f "$file" ] && [ -s "$file" ]; then
        while IFS= read -r line; do
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            if [[ "$line" =~ ^(ssh-|ecdsa-|sk-) ]]; then
                local keytype=$(echo "$line" | awk '{print $1}')
                local comment=$(echo "$line" | awk '{for(i=3;i<=NF;i++) printf "%s ", $i; print ""}' | sed 's/[[:space:]]*$//')
                [ -z "$comment" ] && comment="(sans commentaire)"
                local fp=$(calc_fp "$line")
                local line_b64=$(echo "$line" | base64 -w0)
                echo "KEY:$file|$owner|$keytype|$comment|$fp|$line_b64"
            fi
        done < "$file"
    fi
}

scan_auth_keys "/root/.ssh/authorized_keys" "root"

for user_home in /home/*; do
    [ -d "$user_home" ] || continue
    username=$(basename "$user_home")
    scan_auth_keys "$user_home/.ssh/authorized_keys" "$username"
done

if [ -d /etc/ssh/authorized_keys ]; then
    for f in /etc/ssh/authorized_keys/*; do
        [ -f "$f" ] || continue
        scan_auth_keys "$f" "system"
    done
fi

echo "===KEYSCAN_END==="
KEYSCAN_EOF
)

    KEYSCAN_B64=$(printf '%s' "$KEY_SCAN_SCRIPT" | base64 -w0)
    KEYSCAN_OUTPUT=$(sshpass -e ssh "${SSH_ROOT_OPTS[@]}" "root@$SERVER" \
        "echo '$KEYSCAN_B64' | base64 -d | bash" 2>/dev/null)

    declare -a KEY_FILES=()
    declare -a KEY_OWNERS=()
    declare -a KEY_TYPES=()
    declare -a KEY_COMMENTS=()
    declare -a KEY_FPS=()
    declare -a KEY_LINES_B64=()
    KEY_INDEX=0

    while IFS= read -r line; do
        if [[ "$line" =~ ^KEY: ]]; then
            data="${line#KEY:}"
            IFS='|' read -r file owner keytype comment fp line_b64 <<< "$data"
            KEY_FILES[$KEY_INDEX]="$file"
            KEY_OWNERS[$KEY_INDEX]="$owner"
            KEY_TYPES[$KEY_INDEX]="$keytype"
            KEY_COMMENTS[$KEY_INDEX]="$comment"
            KEY_FPS[$KEY_INDEX]="$fp"
            KEY_LINES_B64[$KEY_INDEX]="$line_b64"
            ((KEY_INDEX++)) || true
        fi
    done <<< "$KEYSCAN_OUTPUT"

    if [ $KEY_INDEX -eq 0 ]; then
        success "✅ Aucune clé SSH trouvée sur le serveur."
    else
        warning "⚠️  $KEY_INDEX clé(s) SSH trouvée(s) sur le serveur !"
        echo
        echo -e "${RED}============================================================${NC}"
        echo -e "${RED}   ⚠️  ALERTE SÉCURITÉ - EXAMEN DES CLÉS${NC}"
        echo -e "${RED}============================================================${NC}"
        echo "   Ces clés peuvent être :"
        echo "     - Des clés légitimes (admin précédent, backup, etc.)"
        echo "     - Des backdoors laissées par un hack"
        echo "     - Des clés oubliées d'anciens employés"
        echo -e "${RED}============================================================${NC}"
        echo
        echo "   #  | Prop.  | Type      | Empreinte      | Fichier / Commentaire"
        echo "   ---|--------|-----------|----------------|------------------------------------------"
        
        for ((i=0; i<KEY_INDEX; i++)); do
            num=$((i+1))
            printf "   %-2d | %-6s | %-9s | %-14s | %s\n" \
                "$num" "${KEY_OWNERS[$i]}" "${KEY_TYPES[$i]}" "${KEY_FPS[$i]}" "${KEY_FILES[$i]}"
            echo "      |        |           |                | ↳ ${KEY_COMMENTS[$i]}"
        done
        
        echo
        echo -e "${YELLOW}============================================================${NC}"
        echo "   Sélection des clés à examiner :"
        echo "     - Numéros séparés par virgules (ex: 1,3,5)"
        echo "     - 'all' pour toutes les sélectionner"
        echo "     - Entrée pour n'en examiner aucune"
        echo -e "${YELLOW}============================================================${NC}"
        echo
        
        read -rp "Numéros des clés à examiner : " selection
        
        declare -a SELECTED_INDICES=()
        
        if [[ -z "$selection" ]]; then
            info "Aucune clé sélectionnée."
        elif [[ "$selection" == "all" ]]; then
            for ((i=0; i<KEY_INDEX; i++)); do
                SELECTED_INDICES+=($i)
            done
        else
            IFS=',' read -ra nums <<< "$selection"
            for num in "${nums[@]}"; do
                num=$(echo "$num" | tr -d '[:space:]')
                if [[ "$num" =~ ^[0-9]+$ ]]; then
                    idx=$((num-1))
                    if [ $idx -ge 0 ] && [ $idx -lt $KEY_INDEX ]; then
                        SELECTED_INDICES+=($idx)
                    else
                        warning "Numéro $num invalide (ignoré)"
                    fi
                else
                    warning "Entrée '$num' invalide (ignorée)"
                fi
            done
        fi
        
        declare -a FINAL_DELETE_INDICES=()
        
        if [ ${#SELECTED_INDICES[@]} -gt 0 ]; then
            echo
            echo "============================================================"
            echo "   CONFIRMATION INDIVIDUELLE"
            echo "============================================================"
            
            for idx in "${SELECTED_INDICES[@]}"; do
                num=$((idx+1))
                echo
                echo -e "${YELLOW}   Clé #$num${NC}"
                echo "   Fichier     : ${KEY_FILES[$idx]}"
                echo "   Propriétaire: ${KEY_OWNERS[$idx]}"
                echo "   Type        : ${KEY_TYPES[$idx]}"
                echo "   Empreinte   : ${KEY_FPS[$idx]}"
                echo "   Commentaire : ${KEY_COMMENTS[$idx]}"
                echo
                if confirm "   ➜  Supprimer cette clé ?" "n"; then
                    FINAL_DELETE_INDICES+=($idx)
                    success "   → Marquée pour suppression"
                else
                    info "   → Conservée"
                fi
            done
        fi
        
        if [ ${#FINAL_DELETE_INDICES[@]} -gt 0 ]; then
            DELETE_LIST=""
            for idx in "${FINAL_DELETE_INDICES[@]}"; do
                DELETE_LIST+="${KEY_LINES_B64[$idx]}"$'\n'
            done
            KEYS_TO_DELETE_B64=$(printf '%s' "$DELETE_LIST" | base64 -w0)
            echo
            success "✅ ${#FINAL_DELETE_INDICES[@]} clé(s) marquée(s) pour suppression."
        else
            KEYS_TO_DELETE_B64=""
            echo
            info "Aucune clé ne sera supprimée."
        fi
    fi
fi

# ============================================================
# ÉTAPE 4 : PARAMÈTRES UTILISATEUR + CLÉ
# ============================================================
echo
echo "============================================================"
echo "   ÉTAPE 4/8 : CRÉATION UTILISATEUR + CLÉ SSH"
echo "============================================================"

if ! confirm "Créer un nouvel utilisateur administrateur ?" "y"; then
    die "Annulé : un utilisateur admin est obligatoire."
fi

echo
read -rp "Nom du nouvel utilisateur [oirdimed] : " ADMIN_USER
ADMIN_USER="${ADMIN_USER:-oirdimed}"
[[ "$ADMIN_USER" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "Nom invalide."

if id "$ADMIN_USER" >/dev/null 2>&1; then
    warning "L'utilisateur $ADMIN_USER existe déjà sur le serveur."
    if ! confirm "Continuer et configurer cet utilisateur existant ?" "y"; then
        die "Annulé."
    fi
fi

read -rsp "Mot de passe pour $ADMIN_USER : " ADMIN_PASSWORD
echo
read -rsp "Confirmer : " ADMIN_PASSWORD_CONFIRM
echo
[[ "$ADMIN_PASSWORD" == "$ADMIN_PASSWORD_CONFIRM" ]] || die "Mots de passe différents."
[[ -n "$ADMIN_PASSWORD" ]] || die "Mot de passe vide."

echo
read -rp "Alias SSH local (ex: monserveur) : " SSH_ALIAS
[[ -n "$SSH_ALIAS" ]] || die "Alias vide."
[[ "$SSH_ALIAS" =~ ^[a-zA-Z0-9_-]+$ ]] || die "Alias invalide."

# Choix du type de clé
if [[ "$SUPPORTS_ED25519" == "yes" ]]; then
    KEY_TYPE="ed25519"
    KEY_ARGS=(-t ed25519)
    info "Type de clé recommandé : Ed25519 (moderne et sécurisé)"
else
    KEY_TYPE="rsa"
    if ssh-keygen --help 2>&1 | grep -q -- "-m"; then
        KEY_ARGS=(-t rsa -b 4096 -m PEM)
    else
        KEY_ARGS=(-t rsa -b 4096)
    fi
    info "Type de clé recommandé : RSA 4096 (compatibilité legacy)"
fi

echo
if ! confirm "Générer une nouvelle clé SSH $KEY_TYPE sur ta machine locale ?" "y"; then
    die "Annulé : une clé SSH est obligatoire."
fi

SSH_DIR="$HOME/.ssh"
KEY_FILE="$SSH_DIR/id_${KEY_TYPE}_${SSH_ALIAS}"

mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"

if [[ -f "$KEY_FILE" ]]; then
    warning "La clé existe déjà : $KEY_FILE"
    if ! confirm "Réutiliser cette clé existante ?" "y"; then
        die "Annulé. Supprime ou renomme la clé existante."
    fi
else
    info "Génération clé $KEY_TYPE..."
    ssh-keygen "${KEY_ARGS[@]}" -f "$KEY_FILE" -C "${ADMIN_USER}@${SERVER}" -N ""
    chmod 600 "$KEY_FILE"
    chmod 644 "${KEY_FILE}.pub"
    success "Clé créée : $KEY_FILE"
fi

PUBLIC_KEY=$(cat "${KEY_FILE}.pub")

# ============================================================
# ÉTAPE 5 : RÉCAPITULATIF AVANT APPLICATION
# ============================================================
echo
echo "============================================================"
echo "   ÉTAPE 5/8 : RÉCAPITULATIF DES ACTIONS"
echo "============================================================"
echo
echo "Voici ce qui va être fait sur le serveur $SERVER :"
echo
echo "  1. Création utilisateur : $ADMIN_USER (avec sudo NOPASSWD)"
echo "  2. Installation clé publique SSH pour $ADMIN_USER"
[[ -n "${KEYS_TO_DELETE_B64:-}" ]] && echo "  3. Suppression de ${#FINAL_DELETE_INDICES[@]} clé(s) SSH suspecte(s)"
echo "  4. Sécurisation SSH de base :"
echo "       - Root SSH désactivé"
echo "       - Mot de passe SSH désactivé"
echo "       - Clé publique obligatoire"
echo "       - MaxAuthTries 3"
echo "       - AllowUsers $ADMIN_USER"
echo "       - X11Forwarding désactivé"
echo
if [[ "$HAS_SUDO" == "no" ]]; then
    echo "  ⚠️  sudo sera installé (absent du serveur)"
fi
if [[ "$SUDOERS_INCLUDE" == "no" ]]; then
    echo "  ⚠️  /etc/sudoers sera modifié pour inclure /etc/sudoers.d/"
fi
echo
echo "  Backup automatique de sshd_config avant modification."
echo "  Test de connexion automatique après application."
echo
echo "============================================================"

if ! confirm "Appliquer ces modifications maintenant ?" "y"; then
    die "Annulé par l'utilisateur."
fi

# ============================================================
# APPLICATION : création utilisateur + clés
# ============================================================
REMOTE_SCRIPT=$(cat <<REMOTE_EOF
#!/bin/bash
set -e

ADMIN_USER="\$1"
PUBLIC_KEY="\$2"
INSTALL_SUDO="\$3"
FIX_SUDOERS_INCLUDE="\$4"
KEYS_TO_DELETE_B64="\$5"

ADMIN_PASSWORD=""
while IFS= read -r line; do
    if [[ "\$line" == "---PASSWORD_SEPARATOR---" ]]; then
        read -r ADMIN_PASSWORD
        break
    fi
done

if [ "\$INSTALL_SUDO" = "yes" ]; then
    echo "Installing sudo..."
    apt-get update -qq && apt-get install -y -qq sudo
fi

if id "\$ADMIN_USER" >/dev/null 2>&1; then
    echo "USER_EXISTS"
else
    useradd -m -s /bin/bash "\$ADMIN_USER"
    echo "USER_CREATED"
fi

echo "\${ADMIN_USER}:\${ADMIN_PASSWORD}" | chpasswd

if getent group sudo >/dev/null 2>&1; then
    usermod -aG sudo "\$ADMIN_USER"
elif getent group wheel >/dev/null 2>&1; then
    usermod -aG wheel "\$ADMIN_USER"
fi

if [ "\$FIX_SUDOERS_INCLUDE" = "yes" ]; then
    if ! grep -qE '^[[:space:]]*#includedir[[:space:]]+/etc/sudoers\.d' /etc/sudoers; then
        echo "" >> /etc/sudoers
        echo "#includedir /etc/sudoers.d" >> /etc/sudoers
        echo "SUDOERS_FIXED"
    fi
fi

mkdir -p /etc/sudoers.d
echo "\$ADMIN_USER ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/\$ADMIN_USER"
chmod 440 "/etc/sudoers.d/\$ADMIN_USER"
visudo -c -f "/etc/sudoers.d/\$ADMIN_USER" >/dev/null 2>&1 || {
    echo "ERROR: sudoers syntax invalid"
    rm -f "/etc/sudoers.d/\$ADMIN_USER"
    exit 1
}

calc_fp() {
    local key_line="\$1"
    local b64=\$(echo "\$key_line" | awk '{print \$2}')
    echo -n "\$b64" | sha256sum 2>/dev/null | cut -c1-16 || echo -n "\$b64" | md5sum 2>/dev/null | cut -c1-16
}

if [ -n "\$KEYS_TO_DELETE_B64" ]; then
    echo "Selective key deletion..."
    DELETE_LIST=\$(echo "\$KEYS_TO_DELETE_B64" | base64 -d)
    
    declare -a TO_DELETE_B64=()
    while IFS= read -r line; do
        [ -z "\$line" ] && continue
        line_b64=\$(echo "\$line" | base64 -w0)
        TO_DELETE_B64+=("\$line_b64")
    done <<< "\$DELETE_LIST"
    
    clean_auth_keys() {
        local file="\$1"
        [ -f "\$file" ] || return 0
        
        local tmp="\${file}.tmp.\$\$"
        local deleted=0
        local kept=0
        
        while IFS= read -r line; do
            if [[ -z "\$line" || "\$line" =~ ^[[:space:]]*# ]]; then
                echo "\$line" >> "\$tmp"
                continue
            fi
            
            local line_b64=\$(echo "\$line" | base64 -w0)
            local should_delete=false
            
            for del_b64 in "\${TO_DELETE_B64[@]}"; do
                if [ "\$line_b64" = "\$del_b64" ]; then
                    should_delete=true
                    break
                fi
            done
            
            if [ "\$should_delete" = true ]; then
                ((deleted++)) || true
            else
                echo "\$line" >> "\$tmp"
                ((kept++)) || true
            fi
        done < "\$file"
        
        if [ \$deleted -gt 0 ]; then
            local owner=\$(stat -c '%U:%G' "\$file" 2>/dev/null || echo "root:root")
            local perms=\$(stat -c '%a' "\$file" 2>/dev/null || echo "600")
            mv "\$tmp" "\$file"
            chown "\$owner" "\$file"
            chmod "\$perms" "\$file"
            echo "CLEANED:\$file (deleted=\$deleted, kept=\$kept)"
        else
            rm -f "\$tmp"
        fi
    }
    
